# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Diagnostic Assets / Large Test PDFs
*.pdf
*.dcm
*.mp4
extracted_en_summary.txt

# Local PDF text cache (confidential workflow reference extraction)
.pdfcache/

# Rendered per-page screenshots + context of the confidential workflow PDF
pdf_image/

# E2E / smoke-test screenshots (local evidence, not source)
e2e-artifacts/

# Playwright walkthrough profile: keeps Chrome's translate prompt switched off
e2e/.profile/

# Throwaway probe payloads written by the walkthrough
e2e/.probe-*

# Local temp helper scripts (never commit; may contain credentials)
.tmp_*

# Throwaway probe/deploy scripts. Credentials belong in the git-ignored .env.local
# and are read through scripts/vps_ssh.py, never written into a script.
scripts/_*
scripts/__pycache__/

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Dependency directories
node_modules/

# Build outputs
dist/
dist-ssr/
*.local

# Environment variables (CRITICAL: NEVER COMMIT REAL SECRETS)
.env
.env.local
.env.*.local

# Editor directories
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
