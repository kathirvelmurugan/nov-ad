{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "project": "nov-ad",
  "orchestration": {
    "provider": "alibaba-qwen-cloud",
    "region": "ap-southeast-1",
    "endpoint": "https://token-plan.maas.qwencloudapi.com/compatible-mode/v1",
    "models": {
      "primary_flagship": "qwen3.8-max",
      "fast_interactive": "qwen3.8-flash",
      "visual_understanding": "qwen3.8-max",
      "realtime_audio": "qwen-audio-3.0-realtime-plus",
      "speech_to_text": "qwen-audio-3.0-asr-flash",
      "alternative_reasoning": "deepseek-v4.1-flash"
    },
    "concurrency": {
      "plan_limit": 6,
      "max_parallel_sessions": 4,
      "safety_buffer_sessions": 2,
      "retry_on_rate_limit": {
        "max_retries": 3,
        "backoff_ms": 1500
      }
    },
    "human_in_the_loop": {
      "enabled": true,
      "require_human_input_for": [
        "clinical_diagnosis_conflict",
        "missing_mandatory_scan_override",
        "custom_pricing_or_vat_waiver",
        "sla_escalation_doctor_reassignment"
      ]
    }
  }
}
