# ==============================================================================
# ALO DOCTOR (nov-ad) - Environment Configuration Template
# DO NOT COMMIT REAL SECRETS TO THE PUBLIC REPO.
# Inject production values directly into Coolify / VPS environment variables.
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000

# PostgreSQL Configuration
DATABASE_URL=postgresql://alo_admin:AloDoctor2026Postgres!@127.0.0.1:5432/alodoctor?schema=public

# MinIO S3 Object Storage Configuration
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_PUBLIC_URL=http://ad.howtostart.in:9000
MINIO_ACCESS_KEY=alo_storage_admin
MINIO_SECRET_KEY=AloDoctor2026MinioStorage!
MINIO_BUCKET=alo-medical-scans
MINIO_REGION=us-east-1

# Alibaba Cloud Model Studio (DashScope / Qwen) AI Configuration
ALIBABA_API_KEY=your_alibaba_api_key_here
ALIBABA_AI_MODEL=qwen-plus
ALIBABA_MAX_CONCURRENT_SESSIONS=4

# Telehealth & Video Consultation
VITE_APP_URL=https://ad.howtostart.in
VITE_DEFAULT_LANGUAGE=ar
VITE_ENABLE_PROFILE_SWITCHER=true
